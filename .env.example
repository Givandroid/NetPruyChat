# Contoh konfigurasi NetPruyChat.
# Salin file ini menjadi ".env" lalu isi nilainya:
#
#   cp .env.example .env
#
# File ".env" berisi kredensial asli dan TIDAK ikut di-commit (lihat .gitignore).

# Port server. Bila dikosongkan, server memakai 3000.
PORT=3000

# --- SMTP Gmail untuk mengirim kode verifikasi (OTP) ---
#
# Cara membuat App Password:
#   1. Aktifkan 2-Step Verification di akun Google Anda.
#   2. Buka: Google Account -> Security -> App passwords
#   3. Buat password aplikasi (16 huruf), salin ke SMTP_PASS tanpa spasi.
#
# Bila ketiga nilai di bawah dikosongkan, server tetap berjalan tetapi kode
# verifikasi hanya dicetak ke console — cukup untuk demo tanpa email asli.

SMTP_USER=emailanda@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=NetPruyChat <emailanda@gmail.com>
